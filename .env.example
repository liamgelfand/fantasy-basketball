# --- ESPN (required) ---
# From your league URL: fantasy.espn.com/basketball/league?leagueId=123456
ESPN_LEAGUE_ID=
# Private leagues: log into fantasy.espn.com, F12 -> Application -> Cookies -> https://fantasy.espn.com
ESPN_S2=
ESPN_SWID=
# Optional: your team id (auto-detected from ESPN_SWID if blank). Run `python -m fbb check` to see ids.
ESPN_TEAM_ID=
# Optional: season label (2026-27 season = 2027). Auto-detected if blank.
ESPN_SEASON=

# --- Claude (only for `report --ai`, `ask`, `chat`) ---
# Runs on your Claude plan through Claude Code: install it and log in (`claude`, then /login).
# No API key is used; an ANTHROPIC_API_KEY set here is ignored.
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (more effort = deeper analysis, more tokens)
CLAUDE_EFFORT=high
CLAUDE_WEB_SEARCH=true

# --- Analysis tuning ---
# model (season stats + light preseason prior, follows minutes/role changes, regresses shooting streaks)
# | blend (legacy: season blended with ESPN projection, 50% at 10 GP) | season | last_30 | last_15 | last_7 | projected
STAT_WINDOW=model
# Comma-separated categories you are punting, e.g. FT%,TO
PUNT_CATEGORIES=
# Free agents to pull and score (by % owned)
FREE_AGENT_POOL=75
# Matchup end detection: weekday the matchup ends (0=Mon..6=Sun) or an explicit date override
MATCHUP_END_WEEKDAY=6
MATCHUP_END_DATE=
